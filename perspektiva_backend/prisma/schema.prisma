generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserInterest {
  userId     String
  interestId Int

  @@id([userId, interestId])
  @@index([interestId], map: "users_interests_interestId_fkey")
  @@map("users_interests")
}

model ArticleInterest {
  articleId  Int
  interestId Int

  @@id([articleId, interestId])
  @@index([interestId], map: "articles_interests_interestId_fkey")
  @@map("articles_interests")
}

model article {
  id          Int    @id @default(autoincrement())
  title       String
  publicistId Int
  content     String @db.LongText

  @@index([publicistId], map: "Article_publicistId_fkey")
}

model interest {
  id   Int    @id @default(autoincrement())
  name String
}

model publicist {
  id       Int     @id @default(autoincrement())
  name     String
  user_id  String @unique
  accepted Boolean @default(false)
  user user @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "user_id")
}

model user {
  id       String  @id @unique @default(uuid())
  email    String  @unique(map: "User_email_key")
  password String
  name     String?
  isAdmin  Boolean @default(false)
  deleted  Boolean @default(false)

  publicist publicist? @relation()
}

model favourites {
  id         Int     @id @default(autoincrement())
  user_id    String?
  article_id Int?

  @@unique([user_id, article_id])
  @@index([article_id], map: "favourites_article_id_fkey")
}

model mediums {
  id      Int     @id @default(autoincrement())
  name    String
  active  Boolean
  user_id String

  @@index([user_id], map: "user_id")
}
