generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ArticleInterest {
  articleId  Int
  interestId Int
  article    article  @relation(fields: [articleId], references: [id])
  interest   interest @relation(fields: [interestId], references: [id])

  @@id([articleId, interestId])
  @@index([interestId], map: "articles_interests_interestId_fkey")
  @@map("articles_interests")
}

model article {
  id          Int               @id @default(autoincrement())
  title       String
  publicistId Int
  content     String            @db.LongText
  publicist   publicist         @relation(fields: [publicistId], references: [id], map: "Article_publicistId_fkey")
  interests   ArticleInterest[]
  favourites  favourites[]

  @@index([publicistId], map: "Article_publicistId_fkey")
}

model interest {
  id       Int               @id @default(autoincrement())
  name     String
  articles ArticleInterest[]
}

model publicist {
  id        Int       @id @default(autoincrement())
  name      String
  user_id   String  @unique
  accepted  Boolean   @default(false)
  medium_id Int
  article   article[]
  user      user     @relation(fields: [user_id], references: [id])
  mediums   mediums   @relation(fields: [medium_id], references: [id], onUpdate: Restrict, map: "publicist_ibfk_2")

  @@index([user_id], map: "user_id")
  @@index([medium_id], map: "medium_id")
}

model user {
  id         String       @id @unique @default(uuid())
  email      String       @unique(map: "User_email_key")
  password   String
  name       String?
  isAdmin    Boolean      @default(false)
  deleted    Boolean      @default(false)
  favourites favourites[]
  publicist  publicist?
}

model favourites {
  id         Int      @id @default(autoincrement())
  user_id    String?
  article_id Int?
  article    article? @relation(fields: [article_id], references: [id], onUpdate: SetNull)
  user       user?    @relation(fields: [user_id], references: [id], onUpdate: SetNull)

  @@unique([user_id, article_id])
  @@index([article_id], map: "favourites_article_id_fkey")
}

model mediums {
  id        Int         @id @default(autoincrement())
  name      String
  url       String      @db.VarChar(1000)
  rss_url   String      @db.VarChar(1000)
  publicist publicist[]
}
